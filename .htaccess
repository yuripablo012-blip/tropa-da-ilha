# Faz o navegador conferir se há versão nova do jogo toda vez que a página abre.
# Sem isto o Chrome guardava uma cópia antiga do index.html e a pessoa não via as atualizações.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Contas dos jogadores (api.php): os dados ficam numa pasta fora do site. Se a hospedagem não deixar,
# o api.php usa a pasta reserva "dados_contas" aqui dentro; esta regra impede que alguém a abra pelo navegador.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/dados_contas(/|$)
</IfModule>
